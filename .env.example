# ============================================
# NVIDIA NIM RAG Backend - Environment Configuration
# ============================================
# Copy this file to .env and update with your values

# Application Settings
APP_NAME=rag-backend
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ============================================
# NVIDIA NIM Configuration
# ============================================
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA Core Models (Enterprise)
NVIDIA_LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_EMBED_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
NVIDIA_RERANK_MODEL=nvidia/llama-3.2-nv-rerankqa-1b-v2

# NVIDIA Multimodal Parsing Models
NVIDIA_PAGE_ELEMENTS_MODEL=nvidia/nemoretriever-page-elements-v2
NVIDIA_TABLE_MODEL=nvidia/nemoretriever-table-structure-v1
NVIDIA_GRAPHIC_MODEL=nvidia/nemoretriever-graphic-elements-v1
NVIDIA_OCR_MODEL=paddleocr

# NVIDIA API Settings
NVIDIA_TIMEOUT=60
NVIDIA_MAX_RETRIES=3

# ============================================
# PostgreSQL Database
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass123

# Full Database URL (auto-constructed if not provided)
# DATABASE_URL=postgresql+asyncpg://raguser:ragpass123@postgres:5432/ragdb

# ============================================
# Qdrant Vector Database
# ============================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents
QDRANT_VECTOR_SIZE=1024

# ============================================
# Redis Cache
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================
# MinIO Object Storage
# ============================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=ragadmin
MINIO_SECRET_KEY=ragpass123
MINIO_SECURE=false
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_ASSETS=parsed-assets

# ============================================
# Neo4j Graph Database (GraphRAG)
# ============================================
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123

# ============================================
# Security & Authentication
# ============================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================
# RAG Configuration
# ============================================
CHUNK_SIZE=768
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=12
RERANK_TOP_K=6
MAX_CONTEXT_TOKENS=6144

# Hybrid Search Configuration
HYBRID_SEARCH_ENABLED=true
KEYWORD_SEARCH_WEIGHT=0.3
ENABLE_RERANKING=true

# ============================================
# Ingestion Settings
# ============================================
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt
INGESTION_BATCH_SIZE=10

# ============================================
# Observability
# ============================================
ENABLE_METRICS=true
METRICS_PORT=9090
TRACING_ENABLED=true
OTLP_ENDPOINT=http://jaeger:4317
RAGAS_EVALUATION_ENABLED=false

# ============================================
# Guardrails Configuration
# ============================================
GUARDRAILS_ENABLED=false
INPUT_GUARDRAILS=true
OUTPUT_GUARDRAILS=true
