# ============================================
# Bodham Retrieval Engine - environment template
# Copy to .env and fill in NVIDIA_API_KEY at minimum.
# ============================================

APP_NAME=bodham-retrieval-engine
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_PORT=8000

# --- Knowledge backend: local (Qdrant hybrid) | foundry_iq (Azure AI Search) | mcp (any MCP server) | mock
KNOWLEDGE_BACKEND=local
KNOWLEDGE_FALLBACK_BACKEND=

# --- MCP: Bodham as an MCP server (/mcp) and as a client of other MCP knowledge servers
MCP_SERVER_ENABLED=true
MCP_REQUIRE_AUTH=true
MCP_API_TOKEN=                       # static service token for agent frameworks (tenant-wide read)
MCP_SERVER_URL=                      # KNOWLEDGE_BACKEND=mcp: e.g. https://<svc>.search.windows.net/knowledgebases/<kb>/mcp?api-version=2026-08-01-preview
MCP_TOOL_NAME=knowledge_retrieve     # Foundry IQ: knowledge_base_retrieve
MCP_AUTH_TOKEN=

# --- Access control (principals on every chunk; filters derived from the verified token)
ACL_ENFORCEMENT=true
ACL_TENANT_SCOPING=true
DEFAULT_DOCUMENT_VISIBILITY=tenant   # private | tenant | public
DEFAULT_TENANT_ID=default

# --- Authentication: local (Bodham JWTs) | entra (Microsoft Entra ID bearer tokens) | both
AUTH_MODE=local
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=                     # expected audience (api://... or client id)
ENTRA_ADMIN_GROUP=                   # group id whose members get the admin role

# --- NVIDIA NIM (https://build.nvidia.com) -- verify model IDs there; deprecated IDs return 404/410
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_LLM_FAST_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_LLM_FALLBACK_MODELS=nvidia/llama-3.3-nemotron-super-49b-v1.5,meta/llama-3.1-70b-instruct
NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-1b-v2
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
NVIDIA_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-1b-v2/reranking
NVIDIA_TIMEOUT=90

# --- Microsoft Foundry IQ / Azure AI Search agentic retrieval (KNOWLEDGE_BACKEND=foundry_iq)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_API_VERSION=2026-08-01-preview
FOUNDRY_IQ_KNOWLEDGE_BASE=
FOUNDRY_IQ_KNOWLEDGE_SOURCE=
FOUNDRY_IQ_REASONING_EFFORT=low

# --- Relational DB (PostgreSQL in Docker; set USE_SQLITE=true for a zero-dependency local run)
USE_SQLITE=false
SQLITE_PATH=./data/bodham.db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass123

# --- Qdrant (server | memory | path)
QDRANT_MODE=server
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents
QDRANT_VECTOR_SIZE=2048
QDRANT_SPARSE_ENABLED=true

# --- Redis (queue, caching, rate limits). REDIS_ENABLED=false + INGESTION_MODE=inline needs no Redis.
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
INGESTION_MODE=queue

# --- Security
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_ANONYMOUS_CHAT=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Retrieval
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CONTEXTUAL_HEADERS=true
TOP_K_RETRIEVAL=24
RERANK_TOP_K=8
MAX_CONTEXT_TOKENS=6144
HYBRID_SEARCH_ENABLED=true
RRF_K=60
ENABLE_RERANKING=true
RERANKER_BACKEND=nvidia
MULTI_QUERY_ENABLED=true
MAX_SUB_QUERIES=4
MAX_TOOL_CALLS=4

# --- Ingestion
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt,md,html,csv
PARSER_BACKEND=auto
ENABLE_KNOWLEDGE_GRAPH=false
ENABLE_OBJECT_STORAGE=false

# --- Structured data gateway (data.query): read-only NL->SQL over your databases
DATA_GATEWAY_ENABLED=true
# Bootstrap connections here or create them via POST /data/connections (persisted in the DB)
DATA_CONNECTIONS_JSON=
# e.g. [{"id":"sales","name":"SalesDB","dialect":"postgres","url":"env:SALES_DB_URL","allowed_schemas":["public"],"denied_columns":["customers.email"]}]
SALES_DB_URL=
DATA_MAX_SQL_CALLS=3

# --- Connectors (SharePoint/OneDrive, Google Drive, Confluence, S3, web, local folder)
CONNECTOR_SCHEDULER_ENABLED=true
CONNECTOR_SCHEDULER_TICK_SECONDS=60
# connector secrets are referenced as env:VAR in connector settings, e.g. SP_CLIENT_SECRET, GDRIVE_TOKEN, CONFLUENCE_TOKEN
SP_CLIENT_SECRET=
GDRIVE_TOKEN=
CONFLUENCE_TOKEN=

# --- Retrieval tiers
ADAPTIVE_RETRIEVAL_ENABLED=true      # rewrite + retry when the reranker finds nothing convincing
RELEVANCE_GATE_THRESHOLD=0.25
SUMMARY_CHUNKS_ENABLED=true          # one document-outline chunk per document for overview questions

# --- Observability / safety
PERSIST_TRACES=true
TRACING_ENABLED=false
OTLP_PROTOCOL=grpc                   # grpc (Jaeger/Tempo/collector) | http (Langfuse, Phoenix)
OTLP_ENDPOINT=http://jaeger:4317     # Langfuse: https://cloud.langfuse.com/api/public/otel/v1/traces
OTLP_HEADERS=                        # Langfuse: Authorization=Basic <base64(pk:sk)>
GUARDRAILS_ENABLED=true
RAGAS_EVALUATION_ENABLED=false
