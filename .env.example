# ============================================
# Dexter Retrieval Engine - environment template
# Copy to .env and fill in NVIDIA_API_KEY at minimum.
# ============================================

APP_NAME=dexter-retrieval-engine
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_PORT=8000

# --- Knowledge backend: local (Qdrant hybrid) | foundry_iq (Azure AI Search) | mock
KNOWLEDGE_BACKEND=local
KNOWLEDGE_FALLBACK_BACKEND=

# --- NVIDIA NIM (https://build.nvidia.com) -- verify model IDs there; deprecated IDs return 404/410
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_LLM_FAST_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_LLM_FALLBACK_MODELS=nvidia/llama-3.3-nemotron-super-49b-v1.5,meta/llama-3.1-70b-instruct
NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-1b-v2
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
NVIDIA_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-1b-v2/reranking
NVIDIA_TIMEOUT=90

# --- Microsoft Foundry IQ / Azure AI Search agentic retrieval (KNOWLEDGE_BACKEND=foundry_iq)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_API_VERSION=2026-08-01-preview
FOUNDRY_IQ_KNOWLEDGE_BASE=
FOUNDRY_IQ_KNOWLEDGE_SOURCE=
FOUNDRY_IQ_REASONING_EFFORT=low

# --- Relational DB (PostgreSQL in Docker; set USE_SQLITE=true for a zero-dependency local run)
USE_SQLITE=false
SQLITE_PATH=./data/dexter.db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass123

# --- Qdrant (server | memory | path)
QDRANT_MODE=server
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents
QDRANT_VECTOR_SIZE=2048
QDRANT_SPARSE_ENABLED=true

# --- Redis (queue, caching, rate limits). REDIS_ENABLED=false + INGESTION_MODE=inline needs no Redis.
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
INGESTION_MODE=queue

# --- Security
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_ANONYMOUS_CHAT=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Retrieval
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CONTEXTUAL_HEADERS=true
TOP_K_RETRIEVAL=24
RERANK_TOP_K=8
MAX_CONTEXT_TOKENS=6144
HYBRID_SEARCH_ENABLED=true
RRF_K=60
ENABLE_RERANKING=true
RERANKER_BACKEND=nvidia
MULTI_QUERY_ENABLED=true
MAX_SUB_QUERIES=4
MAX_TOOL_CALLS=4

# --- Ingestion
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt,md,html,csv
PARSER_BACKEND=auto
ENABLE_KNOWLEDGE_GRAPH=false
ENABLE_OBJECT_STORAGE=false

# --- Observability / safety
PERSIST_TRACES=true
TRACING_ENABLED=false
GUARDRAILS_ENABLED=true
RAGAS_EVALUATION_ENABLED=false
